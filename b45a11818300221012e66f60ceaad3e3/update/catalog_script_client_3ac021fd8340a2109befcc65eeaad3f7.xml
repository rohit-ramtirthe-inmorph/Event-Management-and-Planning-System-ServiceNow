        <name>Event Details</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

   var clientCall = new GlideAjax('EventUtilsCS');
    clientCall.addParam('sysparm_name', 'getEventDetails1');
    clientCall.addParam('sysparm_eventId', newValue);
    
    clientCall.getXMLAnswer(function(response) {
        var eventDetails = JSON.parse(response);
        
        if (eventDetails.error) {
            alert('Event not found! Please check the Event ID.');
            g_form.clearValue('event_id');
        } else {
            alert('Event Details:\n' +
                'Name: ' + eventDetails.event_name + '\n' +
                'Date: ' + eventDetails.event_date + '\n' +
                'Location: ' + eventDetails.location + '\n' +
				'Status: ' + eventDetails.status + '\n' +
				'VIP: ' + eventDetails.vip);
        }
    });
   
}]]></script>
