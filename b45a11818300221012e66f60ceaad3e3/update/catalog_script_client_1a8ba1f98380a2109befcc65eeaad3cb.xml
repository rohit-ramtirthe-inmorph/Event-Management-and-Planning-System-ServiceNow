        <name>Get Attendee Details</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

   var callClient = new GlideAjax('AttendeeUtilsCS');
    callClient.addParam('sysparm_name', 'getAttendeeDetailsById');
    callClient.addParam('sysparm_attendeeId', newValue);
    
    callClient.getXMLAnswer(function(response) {
        var attendeeDetails = JSON.parse(response);
        
        if (attendeeDetails.error) {
            alert('Attendee not found! Please check the Attendee ID.');
            g_form.clearValue('attendee_id');
        } else {
            alert('Attendee Details:\n' +
                'Name: ' + attendeeDetails.firstName +
                'Email: ' + attendeeDetails.email+ '\n' );
        }
    });
   
}]]></script>
