        <script><![CDATA[var TaskUtils = Class.create();
TaskUtils.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

	cancelTask: function() {
        var taskID = this.getParameter('sysparm_taskID');

        var taskGR = new GlideRecord('x_1610434_event_0_event_task'); 
		taskGR.addQuery('sys_id', taskID);
		taskGR.query();
		
        while (taskGR.next()) {
            taskGR.setValue('status', 'cancelled');
            taskGR.update();

            if (taskGR.assigned_to) {
                gs.eventQueue('x_1610434_event_0.task.cancelled.notify', taskGR, taskGR.assigned_to, '');
            }
            
            return 'success';
        }

    },

    type: 'TaskUtils'
});]]></script>
