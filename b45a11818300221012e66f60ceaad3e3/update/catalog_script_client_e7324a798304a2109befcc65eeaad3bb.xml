        <name>Get Locations Availbility</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

   var eventDate = g_form.getValue('event_date');
    
    var ajaxCall = new GlideAjax('EventUtilsClient');
    ajaxCall.addParam('sysparm_name', 'checkLocationAvailability');
    ajaxCall.addParam('sysparm_location', newValue);
    ajaxCall.addParam('sysparm_eventDate', eventDate);

    ajaxCall.getXMLAnswer(function(answer) {
		// alert(answer);
        if (answer === 'false') {
            alert('Location is already booked for the selected date. Please choose another location.');
            g_form.clearValue('location');
        }
		else{
			alert('Location is Available to book for the selected date.');
		}
    });
   
}]]></script>
