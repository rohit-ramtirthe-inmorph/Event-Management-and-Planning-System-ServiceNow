        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var _totalBudget = current.total_budget;
    var _amountSpent = current.amount_spent;
    var _amountRemaining = _totalBudget - _amountSpent;
    if (_amountRemaining < 0) {
        gs.addErrorMessage('Amount Spent Exceeds Total Budget!');
		current.setAbortAction(true);
    } else {
        current.amount_remaining = _amountRemaining;
    }

})(current, previous);]]></script>
