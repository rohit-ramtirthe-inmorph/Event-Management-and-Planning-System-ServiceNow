        <script><![CDATA[function onSubmit() {
	var capacity = parseInt(g_form.getValue('capacity'), 10);
	if (isNaN(capacity) || capacity <= 0) {
        g_form.addErrorMessage('Capacity must be a positive number!');
        return false;
    }
    
