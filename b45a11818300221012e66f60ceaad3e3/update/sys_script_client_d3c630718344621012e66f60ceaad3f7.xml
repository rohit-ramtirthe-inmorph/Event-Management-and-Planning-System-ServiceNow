        <name>Validate Schedule Time</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var startTime = g_form.getValue('start_date');
    var endTime = g_form.getValue('end_date');

    if (startTime && endTime) {
        var startDate = new Date(startTime);
        var endDate = new Date(endTime);

        if (endDate < startDate) {
            g_form.clearMessages();
            g_form.addErrorMessage("End time cannot be before start time. Please correct the schedule times.");
            return false;
        }
    }
}]]></script>
