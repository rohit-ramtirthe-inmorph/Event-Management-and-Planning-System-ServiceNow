	if (isLoading || newValue == '') {
		return;
	}

    var venuName = g_form.getValue('venue_name');
    if (!location) {
        g_form.addErrorMessage('Please fill in the location to check availability.');
        return;
    }

    var callClient = new GlideAjax('VenueUtilsClient');
    callClient.addParam('sysparm_name', 'checkVenueAvailability');
    callClient.addParam('sysparm_venueName', venuName);
    callClient.addParam('sysparm_location', newValue);
    
    callClient.getXMLAnswer(function(response) {
        var availability = JSON.parse(response);
        
        if (availability.available) {
            alert(availability.message);
        } else {
            alert(availability.message);
            g_form.clearValue('venue_name');
        }
    });
   
