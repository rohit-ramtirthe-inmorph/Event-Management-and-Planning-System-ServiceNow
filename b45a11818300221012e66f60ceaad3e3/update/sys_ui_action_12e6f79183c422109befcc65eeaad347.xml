        <name>Submit Feedback</name>
        <onclick>submitFeedback()</onclick>
        <order>100</order>
        <script><![CDATA[function submitFeedback() {
	var feedBackID= g_form.getUniqueValue();
    var rating = g_form.getValue('rating');
    var comments = g_form.getValue('comment');
    var eventID = g_form.getValue('event_id');
	var attendeeID = g_form.getValue('attendee_id');
    
    if (!rating) {
        alert("Please provide a rating before submitting.");
        return;
    }

    var ga = new GlideAjax('FeedbackUtils'); // Call Script Include
    ga.addParam('sysparm_name', 'createFeedback');
	ga.addParam('sysparam_feedbackID',feedBackID);
    ga.addParam('sysparm_rating', rating);
    ga.addParam('sysparm_comments', comments);
    ga.addParam('sysparm_eventID', eventID);
    ga.addParam('sysparm_attendeeID', attendeeID);

    ga.getXMLAnswer(function(response) {
        if (response === 'success') {
            alert("Thank you for your feedback!");
            window.location.reload(); // Reloads the page to reflect changes
        } else {
            alert("Failed to submit feedback. Please try again.");
        }
    });
}
]]></script>
