        <name>Cancel Task</name>
        <onclick>cancelTask()</onclick>
        <order>100</order>
        <script><![CDATA[function cancelTask() {
    if (confirm("Are you sure you want to cancel this task?")) {
        var ga = new GlideAjax('TaskUtils'); // Script Include name
        ga.addParam('sysparm_name', 'cancelTask'); // Function inside the Script Include
        ga.addParam('sysparm_taskID', g_form.getUniqueValue()); // Pass the Task sys_id

        ga.getXMLAnswer(function(response) {
            if (response === 'success') {
                alert("Task has been cancelled successfully!");
                g_form.reload(); // Reload the form to reflect changes
            } else {
                alert("Failed to cancel the task. Please try again.");
            }
        });
    }
}
]]></script>
