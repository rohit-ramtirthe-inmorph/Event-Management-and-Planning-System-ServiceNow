        <order>100</order>
        <script><![CDATA[function approveBudget() {
    var budgetID = g_form.getUniqueValue(); // Get the budget record ID

    if (!budgetID) {
        alert("Budget record not found.");
        return;
    }

    var ga = new GlideAjax('BudgetApprovalUtils'); // Call Script Include
    ga.addParam('sysparm_name', 'approveBudget');
    ga.addParam('sysparm_budgetID', budgetID);

    ga.getXMLAnswer(function(response) {
        if (response === 'success') {
            alert("Budget approved successfully!");
            window.location.reload(); // Reloads the page to reflect changes
        } else {
            alert("Failed to approve budget. Please try again.");
        }
    });
}
]]></script>
